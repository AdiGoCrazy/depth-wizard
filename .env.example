# DepthWizard Backend Environment Variables
# Do NOT hardcode secrets. Copy this file to .env and populate securely.

# API Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Calibration Engine
# OpenTopography API key for fetching SRTM 30m DEM (optional but recommended for high rate limits)
OPENTOPOGRAPHY_API_KEY=your_api_key_here

# Paths
# Temporary storage for generated GeoTIFFs and meshes (must have write permissions)
ASSET_STORAGE_DIR=/tmp/depthwizard_exports/

# Logging
# DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
